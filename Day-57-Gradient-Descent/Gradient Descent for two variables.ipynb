    "- inialize random values for m and b.\n",
    "- suppose m = 1, b = 0.\n",
    "- epochs = 100, learning_rate = 0.01\n",
    "- for i in range epochs\n",
    "      b = b - lr*slope\n",
    "      m = m - lr*slope"
   ]
